+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET) return M_PROPERTY_NOT_IMPLEMENTED;
+    struct demux_export_report r;
+    demux_cache_export_report(mpctx->demuxer, &r);
+    struct mp_recorder_export_report *m = &r.recorder;
+    bool io_ok = r.complete && !r.input_error && !m->packet_error &&
+                 !m->trailer_error && !m->close_error;
+    bool mapped = io_ok && r.finite && r.ranges == 1 && m->segments == 1 &&
+                  !m->overflow && m->timestamps_valid && m->num_streams > 0 &&
+                  isfinite(m->base_ts) && isfinite(m->rebase_ts) &&
+                  isfinite(r.ts_offset);
+    for (int n = 0; n < m->num_streams; n++) {
