+void mp_recorder_enable_export_report(struct mp_recorder *priv)
+{
+    priv->export_report_enabled = true;
+    priv->report.timestamps_valid = true;
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct mp_recorder_sink *rst = priv->streams[n];
+        rst->report_index = -1;
+        if (rst->sh->type != STREAM_VIDEO && rst->sh->type != STREAM_AUDIO) {
+            priv->report.overflow = true; // first trial excludes subtitles
+            continue;
+        }
+        if (priv->report.num_streams == MP_EXPORT_MAX_STREAMS) {
+            priv->report.overflow = true;
+            continue;
+        }
+        rst->report_index = priv->report.num_streams++;
+        rst->sequence = av_sha_alloc();
+        if (!rst->sequence || av_sha_init(rst->sequence, 256) < 0) {
+            av_freep(&rst->sequence);
+            priv->report.packet_error = AVERROR(ENOMEM);
+        }
+        priv->report.streams[rst->report_index] = (struct mp_export_stream) {
+            .source_index = rst->sh->index, .mux_index = rst->av_stream->index,
+            .codec_id = rst->av_stream->codecpar->codec_id,
+            .type = rst->sh->type, .dts_complete = true,
+            .timebase_num = rst->av_stream->time_base.num,
+            .timebase_den = rst->av_stream->time_base.den,
+        };
+        struct mp_export_stream *s = &priv->report.streams[rst->report_index];
+        const AVCodecParameters *input = rst->sh->codec->lav_codecpar;
+        if (!input || input->codec_id != s->codec_id || input->extradata_size < 0 ||
+            input->extradata_size > 1048576) continue;
+        s->source_width = input->width;
+        s->source_height = input->height;
+        s->source_sample_rate = input->sample_rate;
+        s->source_channels = input->ch_layout.nb_channels;
+        const char *format = s->type == STREAM_VIDEO
+            ? av_get_pix_fmt_name(input->format) : NULL;
+        if (format) snprintf(s->source_pixel_format, sizeof(s->source_pixel_format), "%s", format);
+        struct AVSHA *header = av_sha_alloc();
+        if (!header || av_sha_init(header, 256) < 0) {
+            av_free(header);
+            priv->report.packet_error = AVERROR(ENOMEM);
+            continue;
+        }
+        av_sha_update(header, input->extradata, input->extradata_size);
+        av_sha_final(header, s->source_extradata_sha256);
+        av_free(header);
+        s->source_params_known = s->type == STREAM_VIDEO
+            ? input->width > 0 && input->height > 0 &&
+              (format || (input->codec_id == AV_CODEC_ID_H264 && input->extradata_size > 0))
+            : input->sample_rate > 0 && input->ch_layout.nb_channels > 0;
+    }
