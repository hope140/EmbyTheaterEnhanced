+static void export_anchor_node(struct mpv_node *node, struct mp_export_anchor *a)
+{
+    node_map_add_flag(node, "pts-valid", a->pts_valid);
+    node_map_add_flag(node, "dts-valid", a->dts_valid);
+    if (a->pts_valid) {
+        node_map_add_double(node, "input-pts", a->input_pts);
